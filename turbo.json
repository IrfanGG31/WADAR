{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "WADAR_TEST_PG_ADMIN_URL",
        "WADAR_TEST_REDIS_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_*"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "WADAR_TEST_PG_ADMIN_URL",
        "WADAR_TEST_REDIS_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_*"
      ]
    }
  }
}
