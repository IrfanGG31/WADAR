# Supabase (project: Settings › API). The anon/publishable key is public by design;
# the service role key is server-only and must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio) — from D6/D7
GOOGLE_GENERATIVE_AI_API_KEY=

# 1 = cache demo-scenario AI answers and fall back to them (SPRINT-8D §5)
DEMO_SAFE=
