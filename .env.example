# Copy to .env and fill in for local development.
# Never commit the real .env — see CLAUDE.md aturan #11.

NODE_ENV=development

# apps/api
API_PORT=3001
# Comma-separated. apps/web's browser-side calls to this API are cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# apps/worker
WORKER_HEALTH_PORT=3002

# Postgres (infra/docker-compose.yml)
# Runtime role (wadar_app) — non-superuser, NOBYPASSRLS, RLS applies to it.
# Used by apps/api + apps/worker. NEVER use the migrate role here (M1 finding:
# a superuser/table-owner connection bypasses RLS entirely regardless of
# policy — see docs/adr/002-postgres-role-separation-for-rls.md).
DATABASE_URL=postgres://wadar_app:wadar_app@localhost:5432/wadar

# Migrate role (wadar) — superuser/table owner, created by POSTGRES_USER
# above. Used ONLY by `drizzle-kit push`/`generate`/`migrate` (pnpm
# db:generate / db:migrate). Never read by apps/api or apps/worker at
# runtime.
DATABASE_MIGRATE_URL=postgres://wadar:wadar@localhost:5432/wadar

# Redis (infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Sentry — kosongkan untuk disable (tidak error saat boot)
SENTRY_DSN=

# OpenTelemetry — kosong = exporter console saja (lihat README)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Supabase local (diisi otomatis oleh `supabase start`, contoh nilai lokal default)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=

# apps/web — NEXT_PUBLIC_* dikirim ke browser (bukan rahasia; anon key memang
# publik by design, RLS Supabase yang menjaga akses datanya). Nilai default
# di bawah cocok dengan `supabase start` lokal.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001

# Verifikasi JWT Supabase (modules/identity SupabaseJwtGuard) — cek MODE
# sebenarnya per-instance (lihat /auth/v1/jwks: kosong = masih HS256),
# jangan diasumsikan. Project Supabase baru (hosted) defaultnya "jwks";
# `supabase start` lokal (lihat supabase/config.toml — tidak set
# signing_keys_path) masih pakai HS256 dengan secret demo bawaan CLI.
SUPABASE_JWT_MODE=jwks
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
