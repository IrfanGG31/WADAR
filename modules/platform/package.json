    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@wadar/config": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "eslint": "10.11.0",
    "fastify": "^5.12.4",
    "testcontainers": "12.1.0",
